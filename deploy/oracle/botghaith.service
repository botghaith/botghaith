[Unit]
Description=Telegram Bot Ghaith - Educational Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/botghaith
EnvironmentFile=/home/ubuntu/botghaith/.env
ExecStart=/home/ubuntu/botghaith/venv/bin/python bot.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
