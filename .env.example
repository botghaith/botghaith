BOT_TOKEN=your_bot_token_here
ADMIN_USERNAME=qhaith
DATABASE_PATH=data/bot.db
TEMP_DIR=data/temp
CHANNEL_USERNAME=mcqthr
CHANNEL_LINK=https://t.me/mcqthr
CHANNEL_REQUIRED=1

# عند تعبئة SUPABASE_URL + SUPABASE_SECRET_KEY يستخدم البوت Supabase بدل SQLite
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
USE_OFFLINE_TRANSLATE=1
# ملفات: dual = ملفان (بنفس الترتيب + فوق الكلمات) | full = 4 ملفات
FILE_TRANSLATE_MODE=dual
FILE_TRANSLATE_LOCAL=1
# TRANSLATION_USE_SUPABASE=1 لتسجيل نشاط الترجمة في Supabase
# مسار Tesseract (Linux/Render: /usr/bin/tesseract)
TESSERACT_CMD=
# مهلة تحميل الملفات من تيليجرام (ثوانٍ)
TELEGRAM_READ_TIMEOUT=1200
TELEGRAM_WRITE_TIMEOUT=1200
FILE_DOWNLOAD_MAX_ATTEMPTS=8
# مهلة مراحل ترجمة الملف (ثوانٍ)
FILE_PREPARE_TIMEOUT=300
FILE_STRUCTURED_TIMEOUT=900
FILE_OVERLAY_TIMEOUT=1800
