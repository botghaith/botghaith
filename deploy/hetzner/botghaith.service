[Unit]
Description=Telegram Bot Ghaith - Educational Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/home/bot/botghaith
EnvironmentFile=/home/bot/botghaith/.env
ExecStart=/home/bot/botghaith/venv/bin/python bot.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
